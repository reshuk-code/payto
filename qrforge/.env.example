# Postgres connection string (Neon, Supabase, or local).
# Leave empty in development to use the built-in PGlite database stored in .data/
DATABASE_URL=

# Public base URL that goes inside every QR code, e.g. https://qrforge.app
# Set this before printing codes. Falls back to the request host when empty.
APP_URL=

# Max dynamic codes on the free plan.
FREE_PLAN_LIMIT=3
